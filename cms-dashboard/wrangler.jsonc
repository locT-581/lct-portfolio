{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "loct-portfolio",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "0e668e1be9794736b6031f15a0d5304b"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "loct-portfolio-db",
			"database_id": "ebf8639b-4393-42b6-864b-61f53ab85068"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "loct-portfolio-media"
		}
	],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}